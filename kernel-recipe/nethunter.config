# NetHunter extra kernel features for Nothing Phone (3) "Metroid" (SM8735, android15-6.6 GKI)
#
# Everything from the official Kali NetHunter kernel-config pages (kali.org/docs/nethunter/
# nethunter-kernel-*-config-*) that the stock kernel lacks AND that can be added without changing
# the KMI — all as modules, so vmlinux stays identical to Google's build (checked by kmi-check.py).
# Already present elsewhere, so NOT here: stock GKI (CAN core/raw/bcm/gw/dev/slcan/vcan, cdc-acm,
# rtl8150/8152, ftdi_sio, binder, devlink, vsock, USB gadget mass_storage/ECM/HID/FFS, hci_uart)
# and the nethunter-kmods module (USB Wi-Fi incl. Ralink rt2x00, ath9k_htc, mt76, rtl8187, rtl8xxxu;
# USB Bluetooth btusb/bfusb/bcm203x/ath3k/hci_vhci; CAN gs_usb/peak_usb/usb_8dev; ch341/cp210x/pl2303).
# Deliberately left out: SYSVIPC (changes task_struct -> breaks the KMI), USB Wi-Fi that needs mac80211
# (on this phone cfg80211/mac80211 are Qualcomm vendor modules, so those belong in the module, not
# here), DVB/SDR kernel drivers (userspace librtlsdr/hackrf/airspy is the working path and the kernel
# drivers would grab the dongles), SoC/SPI/PCI CAN controllers (no such hardware on a phone),
# USB_SERIAL_CONSOLE / USB_SERIAL_GENERIC (need Google's usbserial core rebuilt/built in).
#
# Merge over the stock config (see build-gki.sh); `make olddefconfig` resolves dependencies.

# --- CAN: ISO-TP and J1939 protocols, more USB adapters, tc ematch on CAN ids ---
CONFIG_CAN_ISOTP=m
CONFIG_CAN_J1939=m
CONFIG_CAN_KVASER_USB=m
CONFIG_CAN_EMS_USB=m
CONFIG_CAN_ESD_USB=m
CONFIG_CAN_UCAN=m
CONFIG_NET_EMATCH_CANID=m

# --- Bluetooth: PAN (BNEP) and the BPA10x USB sniffer adapter ---
CONFIG_BT_BNEP=m
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
CONFIG_BT_HCIBPA10X=m

# --- USB host networking: RNDIS tether, Qualcomm WWAN, CDC MBIM, DM9601, MCS7830 ---
CONFIG_USB_NET_RNDIS_HOST=m
CONFIG_USB_NET_QMI_WWAN=m
CONFIG_USB_NET_CDC_MBIM=m
CONFIG_USB_NET_DM9601=m
CONFIG_USB_NET_MCS7830=m

# --- USB gadget RNDIS (BadUSB networking; configfs parent already =y on stock) ---
CONFIG_USB_CONFIGFS_RNDIS=y

# --- NFC: PN533/PN532 USB readers ---
CONFIG_NFC_PN533_USB=m

# --- NFS client and server (official NetHunter "NFS" page) ---
CONFIG_NFS_FS=m
CONFIG_NFS_V2=m
CONFIG_NFS_V3=m
CONFIG_NFS_V4=m
CONFIG_NFSD=m
CONFIG_NFSD_V4=y

# --- netlink socket monitoring (ss -A netlink), forced module unload (rmmod -f) ---
CONFIG_NETLINK_DIAG=m
CONFIG_MODULE_FORCE_UNLOAD=y
