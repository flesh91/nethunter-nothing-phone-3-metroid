# NetHunter для Nothing Phone (3) — лише модулі (=m), ядро Image лишається гугловим GKI.
# cfg80211/mac80211 потрібні лише для збірки: на телефоні використовуються вендорські (Qualcomm) з vendor_dlkm.
CONFIG_CFG80211=m
CONFIG_MAC80211=m
# Підопції — точно як у Qualcomm (arch/arm64/configs/vendor/sun_perf.config у дереві Nothing),
# інакше не збігаються CRC wiphy_new_nm / ieee80211_alloc_hw_nm і розкладка внутрішніх структур mac80211.
CONFIG_NL80211_TESTMODE=y
# CONFIG_CFG80211_CRDA_SUPPORT is not set
# CONFIG_CFG80211_WEXT is not set
# CONFIG_MAC80211_LEDS is not set
# CONFIG_MAC80211_MESH is not set
# CONFIG_MAC80211_DEBUGFS is not set
# CONFIG_MAC80211_RC_MINSTREL is not set
CONFIG_MAC80211_RC_DEFAULT=""

# --- USB Wi-Fi з monitor mode + injection (in-tree) ---
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH9K_HTC=m
# CARL9170 (AR9170) — лише з ядром NetHunter: usb_poison_anchored_urbs та ін. поза KMI (config/nh-kernel-only.list)
CONFIG_CARL9170=m
# AR6004 USB (FullMAC, без monitor mode)
CONFIG_ATH6KL=m
CONFIG_ATH6KL_USB=m
CONFIG_WLAN_VENDOR_RALINK=y
CONFIG_RT2X00=m
CONFIG_RT2500USB=m
CONFIG_RT73USB=m
CONFIG_RT2800USB=m
CONFIG_RT2800USB_RT33XX=y
CONFIG_RT2800USB_RT35XX=y
CONFIG_RT2800USB_RT3573=y
CONFIG_RT2800USB_RT53XX=y
CONFIG_RT2800USB_RT55XX=y
CONFIG_RT2800USB_UNKNOWN=y
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTL8187=m
CONFIG_RTL8XXXU=m
CONFIG_RTL8XXXU_UNTESTED=y
# rtlwifi rtl8192cu (RTL8188CUS/8192CU) — старий драйвер Realtek поруч із rtl8xxxu (той самий USB ID: хто першим прив'яжеться)
CONFIG_RTL_CARDS=m
CONFIG_RTL8192CU=m
CONFIG_RTW88=m
CONFIG_RTW88_8822BU=m
CONFIG_RTW88_8821CU=m
CONFIG_RTW88_8723DU=m
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_MT7601U=m
CONFIG_MT76x0U=m
CONFIG_MT76x2U=m
CONFIG_MT7663U=m
CONFIG_MT7921U=m
CONFIG_WLAN_VENDOR_ZYDAS=y
# ZD1211RW — лише з ядром NetHunter: usb_wait_anchor_empty_timeout поза KMI (config/nh-kernel-only.list)
CONFIG_ZD1211RW=m
# ZD1201 (802.11b, Wireless Extensions — у стоковому GKI увімкнені). Прошивки zd1201.fw немає в linux-firmware
CONFIG_USB_ZD1201=m
CONFIG_EEPROM_93CX6=m
# Broadcom 4320 USB (RNDIS) — лише з ядром NetHunter: usbnet_pause_rx та ін. вирізані з гуглівського usbnet.ko
CONFIG_USB_NET_RNDIS_WLAN=m

# --- Bluetooth: USB-донгли + VHCI (bluebinder для вбудованого BT) ---
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_HCIBTUSB_BCM=y
CONFIG_BT_HCIBTUSB_RTL=y
CONFIG_BT_HCIBTUSB_MTK=y
CONFIG_BT_ATH3K=m
CONFIG_BT_HCIBCM203X=m
# CONFIG_BT_HCIBPA10X — неможливо на стоковому GKI: hci_set_fw_info захищений у GKI bluetooth.ko
CONFIG_BT_HCIBFUSB=m
CONFIG_BT_HCIVHCI=m

# --- USB-serial (UART-адаптери для hardware hacking, модеми) ---
CONFIG_USB_SERIAL_CH341=m
CONFIG_USB_SERIAL_CP210X=m
CONFIG_USB_SERIAL_PL2303=m
CONFIG_USB_SERIAL_WWAN=m
CONFIG_USB_SERIAL_OPTION=m
CONFIG_USB_SERIAL_QUALCOMM=m

# --- USB-мережа ---
# USB_NET_RNDIS_HOST — неможливо на стоковому GKI: usbnet_cdc_unbind захищений у GKI cdc_ether.ko
#   (збирається як залежність RNDIS_WLAN, але не пакується: ядро NetHunter має свій, gki/)
CONFIG_USB_NET_SMSC95XX=m
# CONFIG_USB_NET_DM9601 — неможливо на стоковому GKI: usbnet_link_change/mii_link_ok захищені у GKI
# CONFIG_USB_NET_MCS7830 — неможливо на стоковому GKI: usbnet_link_change захищений у GKI
# CONFIG_USB_NET_QMI_WWAN — неможливо на стоковому GKI: usbnet_get_ethernet_addr захищений; netdev_upper_get_next_dev_rcu поза KMI
# CONFIG_USB_NET_CDC_MBIM — неможливо на стоковому GKI: експорти cdc_ncm поза KMI

# --- CAN (car hacking): USB-адаптери + протоколи ---
CONFIG_CAN_GS_USB=m
CONFIG_CAN_8DEV_USB=m
CONFIG_CAN_PEAK_USB=m
CONFIG_CAN_F81604=m
CONFIG_CAN_MCBA_USB=m
# can327 (ELM327/OBD-II через serdev/tty) — найтиповіший дешевий CAN-адаптер.
# select CAN_RX_OFFLOAD тягне can_rx_offload_* зі стокового can-dev (CONFIG_CAN_DEV у GKI),
# усі імпорти трьох модулів задоволені незахищеними експортами стокового GKI (перевірено).
CONFIG_CAN_CAN327=m
# CONFIG_CAN_ISOTP — неможливо на стоковому GKI: can_proto_register та ін. захищені у GKI can.ko → ISO-TP у userspace (python-can-isotp)
# CONFIG_CAN_J1939 — неможливо на стоковому GKI: те саме, що ISOTP → userspace (python j1939)
