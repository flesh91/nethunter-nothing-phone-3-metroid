#!/system/bin/sh
# nh-wlan monitor [канал, типово 6] | managed | channel <канал> | coex [stop] | status
# Глобальний monitor mode вбудованого Wi-Fi (Qualcomm qcacld-3.0, параметр con_mode=4).
# Без явно виставленого каналу інтерфейс у моніторі не приймає жодного кадру (NO-CARRIER) —
# тому monitor завжди ставить канал (типово 6).
# Інжекція: стоковий драйвер у моніторі лише приймає; з драйвером інжекції, який модуль підміняє
# після старту (перевірка: nh-wlan-driver status), у цьому ж режимі працює й інжекція.
#
# monitor/managed/channel працюють із con_mode=4 на самому wlan0 — Android Wi-Fi при цьому вимикається.
# coex — окремий шлях: монітор-vdev (mon0) ПОРЯД із підключенням STA на тому ж каналі, Android Wi-Fi
# лишається ввімкненим (потрібен драйвер інжекції, завантажений із sta_monitor_coexist=1 — так робить
# nh-wlan-driver). Захват/інжекція на mon0 — інструментами з Kali chroot (airodump-ng/hcxdumptool -i mon0),
# бо Android-tcpdump не має CAP_NET_RAW на новому інтерфейсі.
STATE=/data/adb/nethunter-kmods-wlan
IFACE=wlan0
MON=mon0
mkdir -p "$STATE"

# параметр con_mode завантаженого драйвера (qca_cld3_wcn7750 на Phone (3))
con_mode_param() {
  for p in /sys/module/qca_cld3_*/parameters/con_mode /sys/module/wlan/parameters/con_mode; do
    [ -w "$p" ] && { echo "$p"; return 0; }
  done
  return 1
}

# iw: в Android його немає; /system/bin/iw з'являється лише після запуску застосунку NetHunter,
# тому запасний варіант — iw з Kali chroot (працює без змонтованих /proc і /dev)
KALI=/data/local/nhsystem/kali-arm64
iw() {
  if command -v iw >/dev/null 2>&1 && [ "$(command -v iw)" != "iw" ]; then command iw "$@"
  elif [ -x "$KALI/usr/sbin/iw" ]; then chroot "$KALI" /usr/sbin/iw "$@"
  else echo "iw not found (install NetHunter Kali chroot)" >&2; return 127; fi
}

# коексистенція доступна, лише якщо драйвер завантажено з sta_monitor_coexist=1 (read-only параметр)
coexistence_enabled() { grep -qx Y /sys/module/qca_cld3_*/parameters/sta_monitor_coexist 2>/dev/null; }
# phy вбудованого радіо (для iw interface add)
wlan_phy() { cat /sys/class/net/$IFACE/phy80211/name 2>/dev/null; }

# збірка драйвера з інжекцією впізнається за параметром, якого у стоковому немає
injection_capable() { ls /sys/module/qca_cld3_*/parameters/injection_dp_inflight_limit >/dev/null 2>&1; }
injection_note() { injection_capable && echo "receive + injection" || echo "receive only: stock driver"; }

# ARPHRD: 1 = ethernet (managed), 803 = radiotap (monitor)
iface_type() { cat /sys/class/net/$IFACE/type 2>/dev/null; }
# cmd передає stdin/stdout у system_server — лише pipe і stdin=/dev/null (SELinux Enforcing)
wifi_enabled() { cmd wifi status </dev/null 2>/dev/null | grep -q "Wifi is enabled"; }

wait_for() { # $1=опис, $2=команда-умова, $3=секунди
  i=0
  while ! eval "$2"; do
    i=$((i+1)); [ $i -ge "$3" ] && { echo "timeout waiting for $1"; return 1; }
    sleep 1
  done
}

set_channel() {
  iw dev $IFACE set channel "$1" 2>&1 && echo "channel: $1" || { echo "failed to set channel $1"; return 1; }
}

P="$(con_mode_param)" || { echo "qcacld con_mode parameter not found"; exit 1; }

case "$1" in
  monitor)
    if [ "$(cat "$P")" = "4" ] && [ "$(iface_type)" = "803" ]; then
      echo "already in monitor mode"
    else
      # запам'ятовуємо, чи був увімкнений Wi-Fi, щоб managed повернув як було
      [ -f "$STATE/wifi_was_enabled" ] || { wifi_enabled && echo 1 || echo 0; } > "$STATE/wifi_was_enabled"
      if wifi_enabled; then
        echo "Turning off Android Wi-Fi (internet via mobile data while monitoring)"
        cmd wifi set-wifi-enabled disabled </dev/null >/dev/null 2>&1
        wait_for "Wi-Fi off" '! wifi_enabled' 15 || exit 1
        sleep 2
      fi
      echo 4 > "$P" || { echo "failed to write con_mode"; exit 1; }
      wait_for "monitor interface" '[ "$(iface_type)" = "803" ]' 10 || { echo 0 > "$P"; exit 1; }
      ip link set $IFACE up || exit 1
      echo "monitor mode: $IFACE ($(injection_note))"
    fi
    set_channel "${2:-6}"
    ;;
  channel)
    [ -n "$2" ] || { echo "usage: nh-wlan channel <N>"; exit 1; }
    [ "$(iface_type)" = "803" ] || { echo "not in monitor mode (run: nh-wlan monitor)"; exit 1; }
    set_channel "$2"
    ;;
  managed)
    if [ "$(cat "$P")" != "0" ] || [ "$(iface_type)" = "803" ]; then
      ip link set $IFACE down 2>/dev/null
      echo 0 > "$P" || { echo "failed to write con_mode"; exit 1; }
      wait_for "managed interface" '[ "$(iface_type)" = "1" ]' 10
      echo "driver back in normal mode"
    fi
    was="$(cat "$STATE/wifi_was_enabled" 2>/dev/null || echo 1)"
    rm -f "$STATE/wifi_was_enabled"
    if [ "$was" = "1" ] && ! wifi_enabled; then
      cmd wifi set-wifi-enabled enabled </dev/null >/dev/null 2>&1
      wait_for "Wi-Fi on" 'wifi_enabled' 15 && echo "Android Wi-Fi turned back on"
    fi
    ;;
  coex)
    if [ "$2" = "stop" ]; then
      [ -e /sys/class/net/$MON ] || { echo "$MON not present"; exit 0; }
      # wifi-vdev видаляється лише через nl80211 (iw dev del), НЕ через ip link del (rtnetlink -> EPERM);
      # del_virtual_intf -> hdd_sta_mon_prepare_stop драйвер сам дренить інжекцію й чисто зупиняє монітор.
      ip link set $MON down 2>/dev/null
      iw dev $MON del || { echo "failed to delete $MON (try: iw dev $MON del)"; exit 1; }
      echo "coexistence monitor removed; $IFACE STA link unaffected"
      exit 0
    fi
    coexistence_enabled || { echo "coexistence not available: driver loaded without sta_monitor_coexist=1 (nh-wlan-driver sets it; reload: nh-wlan-driver restore && nh-wlan-driver swap)"; exit 1; }
    injection_capable || { echo "coexistence needs the injection driver (nh-wlan-driver status)"; exit 1; }
    wifi_enabled || { echo "turn Android Wi-Fi on and connect first — the coexistence monitor rides the STA link's channel"; exit 1; }
    [ "$(iface_type)" = "1" ] || { echo "$IFACE is not in managed mode — run nh-wlan managed first"; exit 1; }
    # A mon0 left over from a torn-down session (real roam/disconnect, or a prior
    # coex) can linger as a dead netdev that refuses to come back up (rtnetlink
    # EPERM). Reuse it only if it is actually up; otherwise delete and recreate.
    if [ -e /sys/class/net/$MON ]; then
      if [ "$(( $(cat /sys/class/net/$MON/flags 2>/dev/null) & 1 ))" = "1" ]; then
        echo "$MON already up"
      else
        iw dev $MON del 2>/dev/null; sleep 1
      fi
    fi
    if [ ! -e /sys/class/net/$MON ]; then
      PHY="$(wlan_phy)"; [ -n "$PHY" ] || { echo "cannot find the Wi-Fi phy"; exit 1; }
      # flags otherbss -> QDF_MONITOR_FLAG_OTHER_BSS -> is_rx_mon -> коекс-шлях (монітор поряд зі STA)
      iw phy "$PHY" interface add $MON type monitor flags otherbss 2>&1 || { echo "failed to add $MON"; exit 1; }
      ip link set $MON up 2>&1 || { iw dev $MON del 2>/dev/null; echo "failed to bring $MON up"; exit 1; }
      sleep 1
      # confirm it really came up (a stale vdev can accept 'up' then stay down)
      [ "$(( $(cat /sys/class/net/$MON/flags 2>/dev/null) & 1 ))" = "1" ] || {
        iw dev $MON del 2>/dev/null; echo "$MON did not come up — retry: nh-wlan coex"; exit 1; }
    fi
    echo "coexistence monitor: $MON up alongside $IFACE on $(iw dev $IFACE link 2>/dev/null | sed -n 's/.*freq: *\([0-9]*\).*/\1 MHz/p' | head -1) (STA stays connected)"
    echo "capture/inject on $MON from the Kali chroot, e.g.: airodump-ng -i $MON  |  hcxdumptool -i $MON"
    echo "stop with: nh-wlan coex stop"
    ;;
  status)
    echo "con_mode: $(cat "$P") ($P)"
    case "$(iface_type)" in 803) echo "$IFACE: monitor";; 1) echo "$IFACE: managed";; "") echo "$IFACE: absent";; *) echo "$IFACE: type $(iface_type)";; esac
    iw dev $IFACE info 2>/dev/null | grep -E "channel" | sed 's/^[[:space:]]*//'
    injection_capable && echo "injection: supported (injection driver loaded)" || echo "injection: not supported (stock driver)"
    if coexistence_enabled; then
      if [ -e /sys/class/net/$MON ]; then
        echo "coexistence: available, $MON active alongside $IFACE"
      else
        echo "coexistence: available (start: nh-wlan coex)"
      fi
    else
      echo "coexistence: not enabled in the loaded driver"
    fi
    wifi_enabled && echo "Android Wi-Fi: on" || echo "Android Wi-Fi: off"
    ;;
  *) echo "usage: nh-wlan monitor [channel, default 6] | managed | channel <N> | coex [stop] | status"; exit 1 ;;
esac
